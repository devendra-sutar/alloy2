apiVersion: v1
kind: ServiceAccount
metadata:
  name: onboarding-sa
  namespace: default
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: onboarding-sa-cluster-admin
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: onboarding-sa
    namespace: default
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: onboarding-config
  namespace: default
data:
  CLUSTER_NAME: "Core-infra"
  USERNAME: "admin"
  PROMETHEUS_URL: "http://10.0.32.103:9090"
  LOKI_URL: "http://10.0.32.103:3100"
  API_HOST: 10.0.32.106:8006     // for to get api status tools installation started and all
---
apiVersion: batch/v1
kind: Job
metadata:
  name: k8s-onboarding-job
  namespace: default
  labels:
    app: onboarding
spec:
  backoffLimit: 1
  template:
    metadata:
      labels:
        app: onboarding
    spec:
      serviceAccountName: onboarding-sa
      restartPolicy: Never
      tolerations:
        - key: "CriticalAddonsOnly"
          operator: "Exists"
          effect: "NoSchedule"
      containers:
        - name: deploy
          image: devendra750/monitoringstack_image:v4
          imagePullPolicy: Always
          envFrom:
            - configMapRef:
                name: onboarding-config
          args:
            - "$(CLUSTER_NAME)"
            - "$(USERNAME)"
            - "$(PROMETHEUS_URL)"
            - "$(LOKI_URL)"
            - "$(API_HOST)"

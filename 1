### Step 6: Event Exporter
echo -e "${BLUE}[INFO]${NC} Processing Event Exporter..."
if [[ "$SKIP_EVENT_EXPORTER" == "true" ]]; then
  echo -e "${YELLOW}[WARN]${NC} Skipping event exporter"
else
  echo -e "${BLUE}[INFO]${NC} Deploying Kubernetes Event Exporter..."
  
  # Try to add bitnami helm repo with retries
  attempts=3
  success=false
  for i in $(seq 1 $attempts); do
    echo -e "${BLUE}[INFO]${NC} Adding bitnami helm repo (attempt $i/$attempts)..."
    if helm repo add bitnami https://charts.bitnami.com/bitnami; then
      success=true
      echo -e "${GREEN}[SUCCESS]${NC} Added bitnami repo"
      break
    fi
    if [[ $i -eq $attempts ]]; then
      echo -e "${RED}[ERROR]${NC} Failed to add bitnami repo after $attempts attempts"
      # Send failure status if API is configured
      if [[ -n "${API_URL:-}" ]]; then
        curl -k --silent --show-error --fail \
             -H "Content-Type: application/json" \
             -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
             "${API_URL}" \
          || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
      fi
      exit 1
    fi
    sleep 2
  done
  
  # Update helm repos with retries
  attempts=3
  success=false
  for i in $(seq 1 $attempts); do
    echo -e "${BLUE}[INFO]${NC} Updating helm repos (attempt $i/$attempts)..."
    if helm repo update; then
      success=true
      echo -e "${GREEN}[SUCCESS]${NC} Updated helm repos"
      break
    fi
    if [[ $i -eq $attempts ]]; then
      echo -e "${RED}[ERROR]${NC} Failed to update helm repos"
      # Send failure status if API is configured
      if [[ -n "${API_URL:-}" ]]; then
        curl -k --silent --show-error --fail \
             -H "Content-Type: application/json" \
             -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
             "${API_URL}" \
          || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
      fi
      exit 1
    fi
    sleep 2
  done
  
  if [[ "$DRY_RUN" == "true" ]]; then
    echo -e "${YELLOW}[INFO]${NC} Dry-run: skipping install of event exporter"
  else
    # Install event exporter with retries
    attempts=3
    success=false
    for i in $(seq 1 $attempts); do
      echo -e "${BLUE}[INFO]${NC} Installing event exporter (attempt $i/$attempts)..."
      if helm install kubernetes-event-exporter \
        bitnami/kubernetes-event-exporter \
        --create-namespace -n "$NAMESPACE" \
        -f "${OUTPUT_DIR}/values.yml" \
        --set image.repository=bitnamilegacy/kubernetes-event-exporter; then
        success=true
        echo -e "${GREEN}[SUCCESS]${NC} Event Exporter deployed"
        break
      fi
      if [[ $i -eq $attempts ]]; then
        echo -e "${RED}[ERROR]${NC} Failed to install event exporter"
        # Send failure status if API is configured
        if [[ -n "${API_URL:-}" ]]; then
          curl -k --silent --show-error --fail \
               -H "Content-Type: application/json" \
               -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
               "${API_URL}" \
            || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
        fi
        exit 1
      fi
      backoff=$(( 2 * (2 ** (i - 1)) ))
      echo -e "${YELLOW}[WARN]${NC} Retry ${i}/${attempts} in ${backoff}s..."
      sleep "$backoff"
    done
  fi
fi
CURRENT_STEP=$((CURRENT_STEP+1))
echo -e "${BLUE}[PROGRESS]${NC} Step $CURRENT_STEP/$TOTAL_STEPS completed"

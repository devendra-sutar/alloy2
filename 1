### Step 9: Trivy Operator & Offline DB Injection
if [[ "$SKIP_TRIVY" != "true" ]]; then
  if [[ "$DRY_RUN" == "true" ]]; then
    log_info "Dry-run: skipping Trivy Operator"
  else
    log_info "Deploying Trivy Operator (Client/Server Mode)..."

    # 1. Create config for Offline Client/Server Mode
    # We disable updates because we will inject the DB manually below
    cat > "${OUTPUT_DIR}/trivy-values.yaml" <<EOF
operator:
  metricsVulnIdEnabled: true
  excludeNamespaces: "kube-system"
serviceMonitor:
  enabled: true
trivy:
  mode: ClientServer
  ignoreUnfixed: true
  server:
    builtIn: true
    replicas: 1
    skipTrivyDbUpdate: true   # STOP internet download attempts
    skipJavaDbUpdate: true    # STOP internet download attempts
service:
  headless: false
EOF

    # 2. Install the Chart
    # Uses the local chart from /app/charts/
    retry_cmd 3 2 helm upgrade --install trivy-operator ./charts/trivy-operator-0.20.1.tgz \
      -n "$NAMESPACE" -f "${OUTPUT_DIR}/trivy-values.yaml"
    
    log_success "Trivy Helm Chart applied."

    # 3. AUTOMATED DB INJECTION LOGIC
    log_info "Starting Offline Database Injection..."
    
    # Wait a moment for the Deployment to create the Pod resource
    sleep 5
    
    # Find the Trivy Server Pod name
    TRIVY_POD=$(kubectl get pods -n "$NAMESPACE" -l app.kubernetes.io/component=server -o jsonpath="{.items[0].metadata.name}" || true)
    
    if [[ -n "$TRIVY_POD" ]]; then
       log_info "Found Trivy Server pod: $TRIVY_POD"
       log_info "Waiting for pod to be ready for file transfer..."
       
       # Wait up to 2 minutes for the pod to be 'Running' so 'kubectl cp' works
       if kubectl wait --for=condition=Ready pod/"$TRIVY_POD" -n "$NAMESPACE" --timeout=120s; then
         
         log_info "Injecting database files..."
         # Copy from local container (/app/db) to the remote Pod
         kubectl cp /app/db/trivy.db "$NAMESPACE/$TRIVY_POD":/home/scanner/.cache/trivy/db/trivy.db
         kubectl cp /app/db/metadata.json "$NAMESPACE/$TRIVY_POD":/home/scanner/.cache/trivy/db/metadata.json
         
         log_success "Database injected successfully."
         
         log_info "Restarting Trivy Server to load the new database..."
         kubectl delete pod "$TRIVY_POD" -n "$NAMESPACE"
         
         # Optional: Delete any failed scan jobs so they retry immediately with the new DB
         kubectl delete job -n "$NAMESPACE" -l app.kubernetes.io/managed-by=trivy-operator 2>/dev/null || true
         
       else
         log_warn "Trivy Server did not become Ready. DB Injection skipped (Manual copy required)."
       fi
    else
       log_warn "Could not find Trivy Server pod. DB Injection skipped."
    fi
  fi
else
  log_info "Skipping Trivy Operator"
fi
CURRENT_STEP=$((CURRENT_STEP+1)); show_progress

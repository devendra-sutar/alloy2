#!/usr/bin/env bash
# Robust Kubernetes Deployment Script
# – Improved reliability with retries & exponential backoff
# – Better error handling and logging
# – ALL API calls use POST (NO GET)
set -euo pipefail

### Configuration Variables
NAMESPACE="onboard"
OUTPUT_DIR="/tmp"
VALUES_TEMPLATE="values-template.yaml"
DEFAULT_OS_USERNAME="default-user"
DEFAULT_OS_PASSWORD="default-password"
DEFAULT_OS_HOST="https://10.0.33.244:9200"
DEFAULT_PROMETHEUS_HOST="http://10.0.2.13:9090"
DEFAULT_LOKI_HOST="http://10.0.2.13:3100"
DEFAULT_TEMPO_HOST=""
DEFAULT_API_HOST="10.0.32.106:8006"  # ← ONLY host:port

### Colors
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

### Logging
log_info()   { echo -e "${BLUE}[INFO]${NC}  $*"; }
log_warn()   { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error()  { echo -e "${RED}[ERROR]${NC} $*" >&2; }
log_success(){ echo -e "${GREEN}[SUCCESS]${NC} $*"; }

### Progress bar
TOTAL_STEPS=10
CURRENT_STEP=0
show_progress(){
  local percent=$(( CURRENT_STEP * 100 / TOTAL_STEPS ))
  local bar_width=50
  local filled=$(( percent * bar_width / 100 ))
  local empty=$(( bar_width - filled ))
  printf "\r["
  printf "%0.s#" $(seq 1 $filled)
  printf "%0.s-" $(seq 1 $empty)
  printf "] %3d%%" "$percent"
  if [ "$CURRENT_STEP" -eq "$TOTAL_STEPS" ]; then
    echo
  fi
}

### Send status update to API (POST ONLY, NON-BLOCKING)
send_status(){
  local status_msg="$1"
  local payload
  payload="{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"${status_msg}\"}"

  if [[ -z "${API_URL:-}" ]]; then
    log_warn "API_URL not set — skipping status update: ${status_msg}"
    return 0
  fi

  log_info "Sending status to API: ${payload}"
  curl -k --silent --show-error --fail \
       -H "Content-Type: application/json" \
       -d "${payload}" \
       "${API_URL}" \
    || log_warn "API call failed for status: ${status_msg}"
}

### Utilities
retry_cmd(){
  local attempts="${1:-3}"; shift
  local sleep_seconds="${1:-2}"; shift
  local i=0
  until "$@"; do
    i=$(( i + 1 ))
    if [ "$i" -ge "$attempts" ]; then
      log_error "Command failed after ${attempts} attempts: $*"
      return 1
    fi
    local backoff=$(( sleep_seconds * (2 ** (i - 1)) ))
    log_warn "Retry ${i}/${attempts} in ${backoff}s..."
    sleep "$backoff"
  done
  return 0
}

### Usage
show_usage(){
  cat <<EOF
Usage: $0 <CLUSTER_NAME> [USERNAME] [PROMETHEUS_URL] [LOKI_URL] [API_HOST] [OPTIONS]
Required:
  CLUSTER_NAME     Cluster identifier
Optional Positional:
  USERNAME         (default: \$K8S_USERNAME or admin-user)
  PROMETHEUS_URL   (default: $DEFAULT_PROMETHEUS_HOST)
  LOKI_URL         (default: $DEFAULT_LOKI_HOST)
  API_HOST         (default: $DEFAULT_API_HOST) → e.g., 10.0.32.126:8006
                                   Full URL becomes: https://API_HOST/api/v2.0/status/update/
Named Options:
  --os-username USER --os-password PASS --os-host URL
  -n/--namespace NS --values-template FILE
  --skip-event-exporter --skip-monitoring --skip-cost-analysis
  --skip-trivy --skip-kyverno --skip-kubearmor
  --dry-run -h|--help
Example:
  $0 kube-cluster admin http://10.0.32.103:9090 http://10.0.32.103:3100 10.0.32.126:8006 --skip-trivy
EOF
  exit 0
}

### Parse positional arguments first
CLUSTER_NAME="${1:-}"; shift || true
USERNAME="${1:-${K8S_USERNAME:-admin-user}}"; shift || true
PROMETHEUS_HOST="${1:-$DEFAULT_PROMETHEUS_HOST}"; shift || true
LOKI_HOST="${1:-$DEFAULT_LOKI_HOST}"; shift || true
API_HOST="${1:-$DEFAULT_API_HOST}"; shift || true

### Parse named options
DRY_RUN=false
SKIP_EVENT_EXPORTER=false
SKIP_MONITORING=false
SKIP_COST_ANALYSIS=false
SKIP_TRIVY=false
SKIP_KYVERNO=false
SKIP_KUBEARMOR=false
OS_USERNAME="$DEFAULT_OS_USERNAME"
OS_PASSWORD="$DEFAULT_OS_PASSWORD"
OS_HOST="$DEFAULT_OS_HOST"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --username)       USERNAME="${2:-}";         shift 2;;
    --os-username)    OS_USERNAME="${2:-}";       shift 2;;
    --os-password)    OS_PASSWORD="${2:-}";       shift 2;;
    --os-host)        OS_HOST="${2:-}";           shift 2;;
    -n|--namespace)   NAMESPACE="${2:-$NAMESPACE}"; shift 2;;
    --values-template)VALUES_TEMPLATE="${2:-$VALUES_TEMPLATE}"; shift 2;;
    --skip-event-exporter)   SKIP_EVENT_EXPORTER=true;   shift;;
    --skip-monitoring)       SKIP_MONITORING=true;       shift;;
    --skip-cost-analysis)    SKIP_COST_ANALYSIS=true;    shift;;
    --skip-trivy)            SKIP_TRIVY=true;            shift;;
    --skip-kyverno)          SKIP_KYVERNO=true;          shift;;
    --skip-kubearmor)        SKIP_KUBEARMOR=true;        shift;;
    --dry-run)               DRY_RUN=true;               shift;;
    -h|--help)               show_usage;;
    *) log_error "Unknown argument: $1"; show_usage;;
  esac
done

### Override with environment variables if set
PROMETHEUS_HOST="${PROMETHEUS_URL:-$PROMETHEUS_HOST}"
LOKI_HOST="${LOKI_URL:-$LOKI_HOST}"
TEMPO_HOST="${TEMPO_HOST:-$DEFAULT_TEMPO_HOST}"

### Default API path (change if you want v1 or other path)
API_PATH="${API_PATH:-/api/v2.0/status/update/}"

### Helpers for validation
_is_host_or_hostport() {
  [[ "$1" =~ ^[0-9A-Za-z.-]+(:[0-9]+)?$ ]]
}
_is_url() {
  [[ "$1" =~ ^https?:// ]]
}

### Build/normalize API_HOST -> API_URL
if [[ -z "${API_HOST:-}" ]]; then
  unset API_URL
else
  if _is_url "$API_HOST"; then
    # API_HOST is a URL. If it contains a path keep it; otherwise append API_PATH
    if [[ "$API_HOST" =~ ^https?://[^/]+/.+ ]]; then
      API_URL="${API_HOST%/}/"    # preserve provided path, ensure single trailing slash
    else
      API_URL="${API_HOST%/}${API_PATH}"
    fi
  else
    # plain host or host:port -> assume https and append API_PATH
    if _is_host_or_hostport "$API_HOST"; then
      API_URL="https://${API_HOST%/}${API_PATH}"
    else
      log_error "API_HOST must be hostname, host:port, ip, or http(s)://... (got: $API_HOST)"
      send_status "Installation Failed" || true
      exit 1
    fi
  fi
fi

log_info "FULL API ENDPOINT: ${API_URL:-<not-set>}"

### Validate required
if [[ -z "${CLUSTER_NAME:-}" ]]; then
  log_error "CLUSTER_NAME is required"
  exit 1
fi

### Validate other hosts (PROMETHEUS_HOST, LOKI_HOST, TEMPO_HOST)
# Accept: http(s)://..., plain hostname, hostname:port, IP, IP:port
validate_host_or_url() {
  local name="$1"; local value="$2"
  [[ -z "$value" ]] && return 0

  if _is_url "$value"; then
    return 0
  fi
  if _is_host_or_hostport "$value"; then
    return 0
  fi

  return 1
}

for var in PROMETHEUS_HOST LOKI_HOST TEMPO_HOST; do
  val="${!var:-}"
  if ! validate_host_or_url "$var" "$val"; then
    log_error "$var must be a hostname, host:port, ip(:port) or http(s)://... (got: $val)"
    send_status "Installation Failed" || true
    exit 1
  fi
done

# Final sanity-check for API_URL (if we require status updates)
if [[ -n "${API_URL:-}" ]]; then
  if ! _is_url "$API_URL"; then
    log_error "Normalized API_URL does not start with http:// or https:// (got: $API_URL)"
    send_status "Installation Failed" || true
    exit 1
  fi
else
  log_warn "API_URL not set — status updates will be skipped."
fi


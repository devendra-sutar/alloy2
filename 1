kubectl apply -f - <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: debug-shell
  namespace: default
spec:
  containers:
  - name: debug
    image: nicolaka/netshoot
    command: [ "sleep", "3600" ]
    # optional: if using an internal network without public internet
    # imagePullPolicy: IfNotPresent
  restartPolicy: Never
EOF
kubectl exec -it debug-shell -- /bin/bash
nslookup grafana.github.io
dig grafana.github.io
curl -v https://grafana.github.io/helm-charts/index.yaml

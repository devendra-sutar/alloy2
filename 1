#!/usr/bin/env bash
set -euo pipefail
set -x  # Enable tracing

log_success() {
  echo "[SUCCESS] $*"
}

log_error() {
  echo "[ERROR] $*" >&2
}

send_status() {
  local status_msg="$1"
  local payload="{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"${status_msg}\"}"
  
  if [[ -z "${API_URL:-}" ]]; then
    echo "[WARN] API_URL not set — skipping status update: ${status_msg}"
  else
    echo "[INFO] Sending status to API: ${payload}"
    curl -k --silent --show-error --fail \
         -H "Content-Type: application/json" \
         -d "${payload}" \
         "${API_URL}" \
      || echo "[WARN] API call failed for status: ${status_msg}"
  fi
}

### ===================
### Positional args
### ===================
CLUSTER_NAME="${1:-}"; shift || true
USERNAME="${1:-${K8S_USERNAME:-admin-user}}"; shift || true
PROMETHEUS_HOST="${1:-}"; shift || true
LOKI_HOST="${1:-}"; shift || true
API_HOST="${1:-}"; shift || true

### ===================
### Default Values
### ===================
NAMESPACE="onboard"

DEFAULT_OS_USERNAME="default-user"
DEFAULT_OS_PASSWORD="default-password"
DEFAULT_OS_HOST="http://localhost:9200"  # Default value

OS_USERNAME="${OS_USERNAME:-$DEFAULT_OS_USERNAME}"
OS_PASSWORD="${OS_PASSWORD:-$DEFAULT_OS_PASSWORD}"
OS_HOST="${OS_HOST:-$DEFAULT_OS_HOST}"
OUTPUT_DIR="/tmp"
VALUES_TEMPLATE="values-template.yaml"

### ===================
### API_HOST from environment or fallback
### ===================
API_HOST="${API_HOST:-}"
API_PATH="/api/v2.0/status/update/"
API_URL=""
if [[ -n "$API_HOST" ]]; then
  if [[ "$API_HOST" =~ ^https?:// ]]; then
    API_URL="${API_HOST%/}${API_PATH}"
  else
    API_URL="https://${API_HOST%/}${API_PATH}"
  fi
fi

### ===================
### Export
### ===================
export CLUSTER_NAME USERNAME PROMETHEUS_HOST LOKI_HOST OS_HOST
export API_HOST API_URL
export NAMESPACE OS_USERNAME OS_PASSWORD

### ===================
### Confirmation Output
### ===================
echo "===== VARIABLES CONFIRMED ====="
echo "CLUSTER_NAME    = $CLUSTER_NAME"
echo "USERNAME        = $USERNAME"
echo "OS_USERNAME     = $OS_USERNAME"
echo "OS_PASSWORD     = $OS_PASSWORD"
echo "OS_HOST         = $OS_HOST"
echo "PROMETHEUS_HOST = $PROMETHEUS_HOST"
echo "LOKI_HOST       = $LOKI_HOST"
echo "API_HOST        = $API_HOST"
echo "API_URL         = $API_URL"
echo "NAMESPACE       = $NAMESPACE"
echo "OUTPUT_DIR      = $OUTPUT_DIR"
echo "VALUES_TEMPLATE = $VALUES_TEMPLATE"
echo "================================"

# Send initial status
send_status "Tool Installation Started"

### Sanitize SA name
SA_NAME=$( echo "$USERNAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9.-]/-/g' | sed 's/^-*//;s/-*$//' )
if ! [[ "$SA_NAME" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$ ]]; then
  log_error "Invalid SA name: '$SA_NAME'"
  send_status "Installation Failed"
  exit 1
fi

echo "SA_NAME created: $SA_NAME"

### Step 2: ServiceAccount + ClusterRoleBinding
kubectl get ns "$NAMESPACE" >/dev/null 2>&1 || kubectl create namespace "$NAMESPACE" >/dev/null 2>&1
echo "Creating ServiceAccount and ClusterRoleBinding..."
kubectl apply -f - <<EOF
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${SA_NAME}
  namespace: ${NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ${SA_NAME}-cluster-admin
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: ServiceAccount
  name: ${SA_NAME}
  namespace: ${NAMESPACE}
EOF
log_success "ServiceAccount + ClusterRoleBinding created"

# Update status
send_status "Service Account Created"

# Create values template
echo "Creating values template..."
cat > "${OUTPUT_DIR}/${VALUES_TEMPLATE}" <<'TEMPLATE_EOF'
config:
  logLevel: error
  logFormat: json
  route:
    routes:
      - match:
        - receiver: "dump"
        drop:
        - namespace: "event-exporter"
        - type: "Normal"
  receivers:
    - name: "dump"
      opensearch:
        hosts:
          - "${OS_HOST}"
        index: "kube-events"
        indexFormat: "kube-events"
        username: "${OS_USERNAME}"
        password: "${OS_PASSWORD}"
        useEventID: true
        deDot: true
        tls:
          insecureSkipVerify: true
        layout:
          eventType: "kubernetes-event"
          createdAt: "{{ .GetTimestampMs }}"
          details:
            message: "{{ .Message }}"
            reason: "{{ .Reason }}"
            type: "{{ .Type }}"
            count: "{{ .Count }}"
            kind: "{{ .InvolvedObject.Kind }}"
            name: "{{ .InvolvedObject.Name }}"
            namespace: "{{ .Namespace }}"
            component: "{{ .Source.Component }}"
            host: "{{ .Source.Host }}"
            labels: "{{ toJson .InvolvedObject.Labels}}"
TEMPLATE_EOF

echo "Template written to ${OUTPUT_DIR}/${VALUES_TEMPLATE}"

# Test the template
if [[ ! -f "${OUTPUT_DIR}/${VALUES_TEMPLATE}" ]]; then
  echo "[ERROR] Template file was not created!"
  exit 1
fi

echo "Template content (first 10 lines):"
head -10 "${OUTPUT_DIR}/${VALUES_TEMPLATE}"

# Render values.yml
echo "Rendering values.yml..."
export OS_USERNAME OS_PASSWORD OS_HOST CLUSTER_NAME SA_NAME
envsubst < "${OUTPUT_DIR}/${VALUES_TEMPLATE}" > "${OUTPUT_DIR}/values.yml"
if [[ ! -s "${OUTPUT_DIR}/values.yml" ]]; then
  echo "[ERROR] Rendered values.yml is empty!" >&2
  echo "Debug info:"
  echo "OS_USERNAME=$OS_USERNAME"
  echo "OS_PASSWORD=$OS_PASSWORD"
  echo "OS_HOST=$OS_HOST"
  send_status "Installation Failed - Template Error"
  exit 1
fi
echo "Created ${OUTPUT_DIR}/values.yml"

echo "Script continuing to next steps..."
# Update status
send_status "Installation In Progress"

# ... rest of your script ...

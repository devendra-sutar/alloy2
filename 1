#!/usr/bin/env bash
# Robust Kubernetes Deployment Script
set -euo pipefail

### Configuration Variables
NAMESPACE="onboard"
OUTPUT_DIR="/tmp"
VALUES_TEMPLATE="values-template.yaml"
DEFAULT_OS_USERNAME="default-user"
DEFAULT_OS_PASSWORD="default-password"
DEFAULT_OS_HOST="https://10.0.33.244:9200"
DEFAULT_PROMETHEUS_HOST="http://10.0.2.13:9090"
DEFAULT_LOKI_HOST="http://10.0.2.13:3100"
DEFAULT_TEMPO_HOST=""
DEFAULT_API_HOST="10.0.32.106:8006"

### Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

### Progress tracking
TOTAL_STEPS=10
CURRENT_STEP=0

### Check if cluster name is provided
if [[ -z "${1:-}" ]]; then
  echo -e "${RED}[ERROR]${NC} CLUSTER_NAME is required"
  echo "Usage: $0 <CLUSTER_NAME> [USERNAME] [PROMETHEUS_URL] [LOKI_URL] [API_HOST] [OPTIONS]"
  exit 1
fi

### Parse arguments
CLUSTER_NAME="$1"
shift || true

USERNAME="${1:-${K8S_USERNAME:-admin-user}}"
shift || true

PROMETHEUS_HOST="${1:-$DEFAULT_PROMETHEUS_HOST}"
shift || true

LOKI_HOST="${1:-$DEFAULT_LOKI_HOST}"
shift || true

API_HOST="${1:-$DEFAULT_API_HOST}"
shift || true

### Parse named options
DRY_RUN=false
SKIP_EVENT_EXPORTER=false
SKIP_MONITORING=false
SKIP_COST_ANALYSIS=false
SKIP_TRIVY=false
SKIP_KYVERNO=false
SKIP_KUBEARMOR=false
OS_USERNAME="$DEFAULT_OS_USERNAME"
OS_PASSWORD="$DEFAULT_OS_PASSWORD"
OS_HOST="$DEFAULT_OS_HOST"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --username)       USERNAME="${2:-}";         shift 2;;
    --os-username)    OS_USERNAME="${2:-}";       shift 2;;
    --os-password)    OS_PASSWORD="${2:-}";       shift 2;;
    --os-host)        OS_HOST="${2:-}";           shift 2;;
    -n|--namespace)   NAMESPACE="${2:-$NAMESPACE}"; shift 2;;
    --values-template)VALUES_TEMPLATE="${2:-$VALUES_TEMPLATE}"; shift 2;;
    --skip-event-exporter)   SKIP_EVENT_EXPORTER=true;   shift;;
    --skip-monitoring)       SKIP_MONITORING=true;       shift;;
    --skip-cost-analysis)    SKIP_COST_ANALYSIS=true;    shift;;
    --skip-trivy)            SKIP_TRIVY=true;            shift;;
    --skip-kyverno)          SKIP_KYVERNO=true;          shift;;
    --skip-kubearmor)        SKIP_KUBEARMOR=true;        shift;;
    --dry-run)               DRY_RUN=true;               shift;;
    -h|--help)
      echo "Usage: $0 <CLUSTER_NAME> [USERNAME] [PROMETHEUS_URL] [LOKI_URL] [API_HOST] [OPTIONS]"
      echo "Example: $0 kube-cluster admin http://10.0.32.103:9090 http://10.0.32.103:3100 10.0.32.126:8006 --skip-trivy"
      exit 0
      ;;
    *) echo -e "${RED}[ERROR]${NC} Unknown argument: $1"; exit 1;;
  esac
done

### Override with environment variables
PROMETHEUS_HOST="${PROMETHEUS_URL:-$PROMETHEUS_HOST}"
LOKI_HOST="${LOKI_URL:-$LOKI_HOST}"
TEMPO_HOST="${TEMPO_HOST:-$DEFAULT_TEMPO_HOST}"

### Default API path
API_PATH="${API_PATH:-/api/v2.0/status/update/}"

### Build API_URL
if [[ -z "${API_HOST:-}" ]]; then
  echo -e "${YELLOW}[WARN]${NC} API_URL not set — status updates will be skipped."
  API_URL=""
else
  if [[ "$API_HOST" =~ ^https?:// ]]; then
    if [[ "$API_HOST" =~ ^https?://[^/]+/.+ ]]; then
      API_URL="${API_HOST%/}/"
    else
      API_URL="${API_HOST%/}${API_PATH}"
    fi
  elif [[ "$API_HOST" =~ ^[0-9A-Za-z.-]+(:[0-9]+)?$ ]]; then
    API_URL="https://${API_HOST%/}${API_PATH}"
  else
    echo -e "${RED}[ERROR]${NC} API_HOST must be hostname, host:port, ip, or http(s)://... (got: $API_HOST)"
    exit 1
  fi
fi

echo -e "${BLUE}[INFO]${NC} FULL API ENDPOINT: ${API_URL:-<not-set>}"

### Validate other hosts
validate_host() {
  local value="$1"
  [[ -z "$value" ]] && return 0
  if [[ "$value" =~ ^https?:// ]] || [[ "$value" =~ ^[0-9A-Za-z.-]+(:[0-9]+)?$ ]]; then
    return 0
  fi
  return 1
}

for var_name in PROMETHEUS_HOST LOKI_HOST TEMPO_HOST; do
  var_value="${!var_name:-}"
  if ! validate_host "$var_value"; then
    echo -e "${RED}[ERROR]${NC} $var_name must be a hostname, host:port, ip(:port) or http(s)://... (got: $var_value)"
    # Send failure status if API is configured
    if [[ -n "${API_URL:-}" ]]; then
      curl -k --silent --show-error --fail \
           -H "Content-Type: application/json" \
           -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
           "${API_URL}" \
        || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
    fi
    exit 1
  fi
done

### Sanitize SA name
SA_NAME=$( echo "$USERNAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9.-]/-/g' | sed 's/^-*//;s/-*$//' )
if ! [[ "$SA_NAME" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$ ]]; then
  echo -e "${RED}[ERROR]${NC} Invalid SA name: '$SA_NAME'"
  # Send failure status if API is configured
  if [[ -n "${API_URL:-}" ]]; then
    curl -k --silent --show-error --fail \
         -H "Content-Type: application/json" \
         -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
         "${API_URL}" \
      || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
  fi
  exit 1
fi

### Check output dir
echo -e "${BLUE}[INFO]${NC} Checking ${OUTPUT_DIR} writability..."
if touch "${OUTPUT_DIR}/test-write" 2>/dev/null && rm -f "${OUTPUT_DIR}/test-write"; then
  echo -e "${GREEN}[SUCCESS]${NC} ${OUTPUT_DIR} is writable"
else
  echo -e "${RED}[ERROR]${NC} ${OUTPUT_DIR} not writable"
  # Send failure status if API is configured
  if [[ -n "${API_URL:-}" ]]; then
    curl -k --silent --show-error --fail \
         -H "Content-Type: application/json" \
         -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
         "${API_URL}" \
      || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
  fi
  exit 1
fi

### KUBECONFIG check
if [[ -n "${KUBECONFIG:-}" ]]; then
  if [[ ! -f "$KUBECONFIG" ]]; then
    echo -e "${RED}[ERROR]${NC} KUBECONFIG not found: $KUBECONFIG"
    # Send failure status if API is configured
    if [[ -n "${API_URL:-}" ]]; then
      curl -k --silent --show-error --fail \
           -H "Content-Type: application/json" \
           -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
           "${API_URL}" \
        || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
    fi
    exit 1
  fi
  if [[ ! -r "$KUBECONFIG" ]]; then
    echo -e "${RED}[ERROR]${NC} KUBECONFIG not readable"
    # Send failure status if API is configured
    if [[ -n "${API_URL:-}" ]]; then
      curl -k --silent --show-error --fail \
           -H "Content-Type: application/json" \
           -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
           "${API_URL}" \
        || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
    fi
    exit 1
  fi
fi
echo -e "${GREEN}[SUCCESS]${NC} KUBECONFIG accessible"

### Send initial status
if [[ -n "${API_URL:-}" ]]; then
  echo -e "${BLUE}[INFO]${NC} Sending initial status to API..."
  curl -k --silent --show-error --fail \
       -H "Content-Type: application/json" \
       -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Tool Installation Started\"}" \
       "${API_URL}" \
    || echo -e "${YELLOW}[WARN]${NC} API call failed for initial status"
fi

### Step 1: Prereqs
echo -e "${BLUE}[INFO]${NC} Checking required tools: kubectl, helm, envsubst, curl, awk"
for tool in kubectl helm envsubst curl awk; do
  if ! command -v "$tool" >/dev/null; then
    echo -e "${RED}[ERROR]${NC} Missing tool: $tool"
    # Send failure status if API is configured
    if [[ -n "${API_URL:-}" ]]; then
      curl -k --silent --show-error --fail \
           -H "Content-Type: application/json" \
           -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
           "${API_URL}" \
        || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
    fi
    exit 1
  fi
done
echo -e "${GREEN}[SUCCESS]${NC} Tools ready"
CURRENT_STEP=$((CURRENT_STEP+1))
echo -e "${BLUE}[PROGRESS]${NC} Step $CURRENT_STEP/$TOTAL_STEPS completed"

### Step 2: ServiceAccount + ClusterRoleBinding
echo -e "${BLUE}[INFO]${NC} Creating ServiceAccount and ClusterRoleBinding..."
kubectl get ns "$NAMESPACE" >/dev/null 2>&1 || kubectl create namespace "$NAMESPACE" >/dev/null 2>&1

attempts=3
for i in $(seq 1 $attempts); do
  if kubectl apply -f - <<EOF >/dev/null 2>&1
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${SA_NAME}
  namespace: ${NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ${SA_NAME}-cluster-admin
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: ServiceAccount
  name: ${SA_NAME}
  namespace: ${NAMESPACE}
EOF
  then
    break
  fi
  if [[ $i -eq $attempts ]]; then
    echo -e "${RED}[ERROR]${NC} Failed to create ServiceAccount after $attempts attempts"
    # Send failure status if API is configured
    if [[ -n "${API_URL:-}" ]]; then
      curl -k --silent --show-error --fail \
           -H "Content-Type: application/json" \
           -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
           "${API_URL}" \
        || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
    fi
    exit 1
  fi
  backoff=$(( 2 * (2 ** (i - 1)) ))
  echo -e "${YELLOW}[WARN]${NC} Retry ${i}/${attempts} in ${backoff}s..."
  sleep "$backoff"
done
echo -e "${GREEN}[SUCCESS]${NC} ServiceAccount + ClusterRoleBinding created"
CURRENT_STEP=$((CURRENT_STEP+1))
echo -e "${BLUE}[PROGRESS]${NC} Step $CURRENT_STEP/$TOTAL_STEPS completed"

### Step 3: Namespace conflict check
echo -e "${BLUE}[INFO]${NC} Checking for conflicting namespaces..."
for ns in alloy kubesage-security kyverno node-feature-discovery kubearmor; do
  if kubectl get ns "$ns" >/dev/null 2>&1; then
    echo -e "${RED}[ERROR]${NC} Namespace '$ns' exists. Cannot proceed."
    # Send failure status if API is configured
    if [[ -n "${API_URL:-}" ]]; then
      curl -k --silent --show-error --fail \
           -H "Content-Type: application/json" \
           -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
           "${API_URL}" \
        || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
    fi
    exit 1
  fi
done
echo -e "${GREEN}[SUCCESS]${NC} No conflicting namespaces"
CURRENT_STEP=$((CURRENT_STEP+1))
echo -e "${BLUE}[PROGRESS]${NC} Step $CURRENT_STEP/$TOTAL_STEPS completed"

### Step 4: Values template
echo -e "${BLUE}[INFO]${NC} Creating values template..."
cat > "${OUTPUT_DIR}/${VALUES_TEMPLATE}" <<'EOF'
config:
  logLevel: error
  logFormat: json
  route:
    routes:
      - match:
        - receiver: "dump"
        drop:
        - namespace: "event-exporter"
        - type: "Normal"
  receivers:
    - name: "dump"
      opensearch:
        hosts:
          - "${OS_HOST}"
        index: "kube-events"
        indexFormat: "kube-events"
        username: "${OS_USERNAME}"
        password: "${OS_PASSWORD}"
        useEventID: true
        deDot: true
        tls:
          insecureSkipVerify: true
        layout:
          eventType: "kubernetes-event"
          createdAt: "{{ .GetTimestampMs }}"
          details:
            message: "{{ .Message }}"
            reason: "{{ .Reason }}"
            type: "{{ .Type }}"
            count: "{{ .Count }}"
            kind: "{{ .InvolvedObject.Kind }}"
            name: "{{ .InvolvedObject.Name }}"
            namespace: "{{ .Namespace }}"
            component: "{{ .Source.Component }}"
            host: "{{ .Source.Host }}"
            labels: "{{ toJson .InvolvedObject.Labels}}"
EOF
echo -e "${GREEN}[SUCCESS]${NC} Values template created"
CURRENT_STEP=$((CURRENT_STEP+1))
echo -e "${BLUE}[PROGRESS]${NC} Step $CURRENT_STEP/$TOTAL_STEPS completed"

### Send progress status
if [[ -n "${API_URL:-}" ]]; then
  echo -e "${BLUE}[INFO]${NC} Sending progress status..."
  curl -k --silent --show-error --fail \
       -H "Content-Type: application/json" \
       -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation In Progress...\"}" \
       "${API_URL}" \
    || echo -e "${YELLOW}[WARN]${NC} API call failed for progress status"
fi

### Step 5: Render values
echo -e "${BLUE}[INFO]${NC} Rendering values template..."
export OS_USERNAME OS_PASSWORD OS_HOST CLUSTER_NAME SA_NAME
envsubst < "${OUTPUT_DIR}/${VALUES_TEMPLATE}" > "${OUTPUT_DIR}/values.yml"
if [[ $? -ne 0 ]]; then
  echo -e "${RED}[ERROR]${NC} envsubst failed"
  # Send failure status if API is configured
  if [[ -n "${API_URL:-}" ]]; then
    curl -k --silent --show-error --fail \
         -H "Content-Type: application/json" \
         -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
         "${API_URL}" \
      || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
  fi
  exit 1
fi
if [[ ! -s "${OUTPUT_DIR}/values.yml" ]]; then
  echo -e "${RED}[ERROR]${NC} Rendered values.yml is empty"
  # Send failure status if API is configured
  if [[ -n "${API_URL:-}" ]]; then
    curl -k --silent --show-error --fail \
         -H "Content-Type: application/json" \
         -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
         "${API_URL}" \
      || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
  fi
  exit 1
fi
echo -e "${GREEN}[SUCCESS]${NC} Values rendered"
CURRENT_STEP=$((CURRENT_STEP+1))
echo -e "${BLUE}[PROGRESS]${NC} Step $CURRENT_STEP/$TOTAL_STEPS completed"

### Step 6: Event Exporter
echo -e "${BLUE}[INFO]${NC} Processing Event Exporter..."
if [[ "$SKIP_EVENT_EXPORTER" == "true" ]]; then
  echo -e "${YELLOW}[WARN]${NC} Skipping event exporter"
else
  echo -e "${BLUE}[INFO]${NC} Deploying Kubernetes Event Exporter..."
  
  attempts=3
  for i in $(seq 1 $attempts); do
    if helm repo add bitnami https://charts.bitnami.com/bitnami >/dev/null 2>&1; then
      break
    fi
    if [[ $i -eq $attempts ]]; then
      echo -e "${RED}[ERROR]${NC} Failed to add bitnami repo"
      # Send failure status if API is configured
      if [[ -n "${API_URL:-}" ]]; then
        curl -k --silent --show-error --fail \
             -H "Content-Type: application/json" \
             -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
             "${API_URL}" \
          || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
      fi
      exit 1
    fi
    sleep 2
  done
  
  attempts=3
  for i in $(seq 1 $attempts); do
    if helm repo update >/dev/null 2>&1; then
      break
    fi
    if [[ $i -eq $attempts ]]; then
      echo -e "${RED}[ERROR]${NC} Failed to update helm repos"
      # Send failure status if API is configured
      if [[ -n "${API_URL:-}" ]]; then
        curl -k --silent --show-error --fail \
             -H "Content-Type: application/json" \
             -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
             "${API_URL}" \
          || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
      fi
      exit 1
    fi
    sleep 2
  done
  
  if [[ "$DRY_RUN" == "true" ]]; then
    echo -e "${YELLOW}[INFO]${NC} Dry-run: skipping install of event exporter"
  else
    attempts=3
    for i in $(seq 1 $attempts); do
      if helm install kubernetes-event-exporter \
        bitnami/kubernetes-event-exporter \
        --create-namespace -n "$NAMESPACE" \
        -f "${OUTPUT_DIR}/values.yml" \
        --set image.repository=bitnamilegacy/kubernetes-event-exporter >/dev/null 2>&1; then
        break
      fi
      if [[ $i -eq $attempts ]]; then
        echo -e "${RED}[ERROR]${NC} Failed to install event exporter"
        # Send failure status if API is configured
        if [[ -n "${API_URL:-}" ]]; then
          curl -k --silent --show-error --fail \
               -H "Content-Type: application/json" \
               -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
               "${API_URL}" \
            || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
        fi
        exit 1
      fi
      backoff=$(( 2 * (2 ** (i - 1)) ))
      echo -e "${YELLOW}[WARN]${NC} Retry ${i}/${attempts} in ${backoff}s..."
      sleep "$backoff"
    done
    echo -e "${GREEN}[SUCCESS]${NC} Event Exporter deployed"
  fi
fi
CURRENT_STEP=$((CURRENT_STEP+1))
echo -e "${BLUE}[PROGRESS]${NC} Step $CURRENT_STEP/$TOTAL_STEPS completed"

### Step 7: Monitoring Stack
echo -e "${BLUE}[INFO]${NC} Processing Monitoring Stack..."
if [[ "$SKIP_MONITORING" != "true" ]]; then
  echo -e "${BLUE}[INFO]${NC} Deploying monitoring stack…"
  
  kubectl get crds | grep 'monitoring.coreos.com' | awk '{print $1}' | while read -r crd; do
    kubectl label crd "$crd" app.kubernetes.io/managed-by=Helm --overwrite
    kubectl annotate crd "$crd" meta.helm.sh/release-name="my-release" --overwrite
    kubectl annotate crd "$crd" meta.helm.sh/release-namespace="onboard" --overwrite
  done
  
  attempts=3
  for i in $(seq 1 $attempts); do
    if helm repo add grafana https://grafana.github.io/helm-charts >/dev/null 2>&1; then
      break
    fi
    if [[ $i -eq $attempts ]]; then
      echo -e "${RED}[ERROR]${NC} Failed to add grafana repo"
      # Send failure status if API is configured
      if [[ -n "${API_URL:-}" ]]; then
        curl -k --silent --show-error --fail \
             -H "Content-Type: application/json" \
             -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
             "${API_URL}" \
          || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
      fi
      exit 1
    fi
    sleep 2
  done
  
  attempts=3
  for i in $(seq 1 $attempts); do
    if helm repo update >/dev/null 2>&1; then
      break
    fi
    if [[ $i -eq $attempts ]]; then
      echo -e "${RED}[ERROR]${NC} Failed to update helm repos"
      # Send failure status if API is configured
      if [[ -n "${API_URL:-}" ]]; then
        curl -k --silent --show-error --fail \
             -H "Content-Type: application/json" \
             -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
             "${API_URL}" \
          || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
      fi
      exit 1
    fi
    sleep 2
  done
  
  RELEASE_NAME="my-release"
  helm_args=(
    --version 1.5.1
    -n "$NAMESPACE" --create-namespace
    --set opencost.enabled=false
    --set cluster.name="$CLUSTER_NAME"
    --set externalServices.prometheus.host="$PROMETHEUS_HOST"
    --set externalServices.prometheus.writeEndpoint=/api/v1/write
    --set externalServices.prometheus.externalLabels.username="$SA_NAME"
    --set externalServices.loki.host="$LOKI_HOST"
    --set grafana.enabled=true
  )
  
  if [[ -n "$TEMPO_HOST" ]]; then
    helm_args+=( --set externalServices.tempo.host="$TEMPO_HOST" )
  fi
  
  echo -e "${BLUE}[INFO]${NC} Installing helm chart: grafana/k8s-monitoring (release=${RELEASE_NAME})"
  
  if [[ "$DRY_RUN" == "true" ]]; then
    echo -e "${YELLOW}[INFO]${NC} Dry-run: skipping install of monitoring stack"
  else
    attempts=3
    for i in $(seq 1 $attempts); do
      if helm upgrade --install "${RELEASE_NAME}" grafana/k8s-monitoring "${helm_args[@]}" >/dev/null 2>&1; then
        break
      fi
      if [[ $i -eq $attempts ]]; then
        echo -e "${RED}[ERROR]${NC} Monitoring stack installation failed"
        # Send failure status if API is configured
        if [[ -n "${API_URL:-}" ]]; then
          curl -k --silent --show-error --fail \
               -H "Content-Type: application/json" \
               -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
               "${API_URL}" \
            || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
        fi
        exit 1
      fi
      backoff=$(( 2 * (2 ** (i - 1)) ))
      echo -e "${YELLOW}[WARN]${NC} Retry ${i}/${attempts} in ${backoff}s..."
      sleep "$backoff"
    done
    echo -e "${GREEN}[SUCCESS]${NC} Monitoring stack installation command executed (release=${RELEASE_NAME})"
  fi
else
  echo -e "${YELLOW}[INFO]${NC} Monitoring stack skipped"
fi
CURRENT_STEP=$((CURRENT_STEP+1))
echo -e "${BLUE}[PROGRESS]${NC} Step $CURRENT_STEP/$TOTAL_STEPS completed"

### Step 8: Cost Analysis
echo -e "${BLUE}[INFO]${NC} Processing Cost Analysis..."
if [[ "$SKIP_COST_ANALYSIS" != "true" ]]; then
  if [[ "$DRY_RUN" == "true" ]]; then
    echo -e "${YELLOW}[INFO]${NC} Dry-run: skipping cost analysis"
  else
    echo -e "${BLUE}[INFO]${NC} Deploying cost analysis (Kepler, OpenCost, Alloy)..."
    
    attempts=3
    for i in $(seq 1 $attempts); do
      if helm repo add kepler https://sustainable-computing-io.github.io/kepler-helm-chart >/dev/null 2>&1; then
        break
      fi
      if [[ $i -eq $attempts ]]; then
        echo -e "${RED}[ERROR]${NC} Failed to add kepler repo"
        # Send failure status if API is configured
        if [[ -n "${API_URL:-}" ]]; then
          curl -k --silent --show-error --fail \
               -H "Content-Type: application/json" \
               -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
               "${API_URL}" \
            || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
        fi
        exit 1
      fi
      sleep 2
    done
    
    attempts=3
    for i in $(seq 1 $attempts); do
      if helm repo add opencost https://opencost.github.io/opencost-helm-chart >/dev/null 2>&1; then
        break
      fi
      if [[ $i -eq $attempts ]]; then
        echo -e "${RED}[ERROR]${NC} Failed to add opencost repo"
        # Send failure status if API is configured
        if [[ -n "${API_URL:-}" ]]; then
          curl -k --silent --show-error --fail \
               -H "Content-Type: application/json" \
               -d "{\"cluster_name\":\"${CLUSTER_NAME}\",\"status\":\"Installation Failed\"}" \
               "${API_URL}" \
            || echo -e "${YELLOW}[WARN]${NC} API call failed for failure status"
